<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/bottstrap 5 modified/bootstrap.min.css">
  <link rel="stylesheet" href="/dashboard.css">
  <link rel="icon" type="image/png" href="/images/logo_green.png">
  <title>Dash Board</title>
</head>

<body>





  <%- include('../partner/partials/navbar') %>


    <div class="dashboard">

      <!-- Success message -->
      <% if (successMessage) { %>
        <div class="alert success">
          <%= successMessage %>
        </div>
        <% } %>



          <div class="row">



            <div class=" row">
              <div style="text-align: center;" class="col-md-6 ">

                <img src="/images/bread.png" alt="">
              </div>


              <div style="text-align: center;" class="col-md-6 ">
                <img src="/images/carrot.png" alt="">
              </div>
            </div>

            <h1>Invoices Table</h1>






            <!-- Search Bar -->
            <div class="search-container">
              <input type="text" id="searchInput" placeholder="Search orders..."
                onkeyup="filterTable('searchInput', 'bagstable')">
            </div>

          </div>


          <div class="table-container">
           
              <table id="bagstable">
                <thead>
                  <tr>
                    <th>Order Number</th>
                    <th>Total Price</th>
                    <th>Status</th>
                    <th>Quantity</th>
                    <th>Bag Name</th>
                    <th>Partner Name</th>
                    
                  </tr>
                </thead>
                <tbody>
                  <% if (order.length> 0) { %>
                  <% order.forEach(orders=> { %>
                    <tr>
                      <td>
                        <%= orders.orderCode %>
                      </td>
                      <td>
                        <%= orders.totalPrice %>
                      </td>
                      <td>
                        <%= orders.status %>
                      </td>
                      <td>
                        <%= orders.orderQuantity %>

                      </td>
                      <td>
                        <%= orders.bag_name %>
                      </td>
                      <td>
                        <%= orders.partner_name %>

                      </td>

                    </tr>
                    <% }) %>
                    <% } else { %>
                      <tr>
                        <td style="text-align: center;" colspan="9">No Orders .</td>
                    </tr>
                <% } %>

                </tbody>
              </table>

              
          </div>
    </div>




    <script src="/dashboard.js"></script>
</body>

</html>