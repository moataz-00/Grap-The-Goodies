<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/aos/aos.css">
    <link rel="stylesheet" href="/bottstrap 5 modified/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/png" href="/images/logo_green.png">
    <title>Support</title>
</head>

<body>
    <p id="responseMessage"></p>

    <div class="row align-items-center text-center text-md-left">

        <!-- Logo -->
        <div class="nav-link col-12 col-md-6 mt-3">
            <img src="/images/logo_green.png" alt="Logo" class="img-fluid">
        </div>
        <!-- Shop Now Button -->
        
    
        
    
        <!-- Login/Signup Buttons -->
        <div class="col-12 col-md-6 mt-3 d-flex justify-content-center justify-content-md-end">
            <a href="/shop" class="me-2">
                <button class="reg">Shop Now</button>
            </a>
            <a  href="/partner/login" class="me-2 dissapear">
                <button class="log">Business</button>
            </a>
            <a href="/user/login" class="me-2 dissapear">
                <button class="reg">Log In</button>
            </a>
        </div>
    </div>

    <section style="width: 100%;">


        <div class="container support">
            <section>
                <div data-aos="fade-up" data-aos-duration="3000" class="mt-5">
                    <div class="row">
                        <p class="head"><span style="color: #8cc342;">Need</span> Help?</p>
                    </div>
                    <div class="row">
                        <p style="word-spacing: 5px;" class="p1 ">
                            Support you in any time
                        </p>
                    </div>


                </div>


            </section>

            <div data-aos="fade-up" data-aos-duration="3000" class="seprate row">
                <div style="text-align: center;" class="col-md-4 mt-5">

                    <img src="/images/bread.png" alt="">
                </div>

                <div class="col-md-4">
                    <div class="vertical-line mx-auto mt-5"></div>
                </div>

                <div style="text-align: center;" class="col-md-4 mt-5">
                    <img src="/images//carrot.png" alt="">
                </div>
            </div>

            <section>
                <div class="row mt-5">
                    <div class="col-md-7">

                        <div data-aos="fade-up" data-aos-duration="3000" class="head">
                            <p>FAQS</p>
                        </div>

                        <div data-aos="fade-up" data-aos-duration="3000" class="accordion">
                            <div class="accordion-item">
                                <div class="accordion-header" onclick="toggleAccordion(this)">
                                    How much does it cost ?
                                </div>
                                <div class="accordion-content">
                                    <p>The website is free to use, and Surprise Bags are sold for great prices that will
                                        differ depending on their contents.</p>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <div class="accordion-header" onclick="toggleAccordion(this)">
                                    Do you have a list with stores in the neighbourhood ?
                                </div>
                                <div class="accordion-content">
                                    <p>Once you sign up,
                                        you can search for participating stores near you, browse Surprise Bags, and even
                                        bookmark your favourite stores!</p>
                                </div>
                            </div>


                            <div class="accordion-item">
                                <div class="accordion-header" onclick="toggleAccordion(this)">
                                    What kind of products can I find on the app ?
                                </div>
                                <div class="accordion-content">
                                    <p>We work with lots of different types of stores and restaurants, so you'll find
                                        anything from supermarket groceries, to hotel breakfasts, to fresh pastries from
                                        bakeries. <br><br>

                                        Any fresh food that hasn't passed its use by date can be sold on the app.</p>
                                </div>
                            </div>

                            <div class="accordion-item">
                                <div class="accordion-header" onclick="toggleAccordion(this)">
                                    Do I need an account to use Grap The Goodies services ?
                                </div>
                                <div class="accordion-content">
                                    <p>Yes, signing up allows you to access all features, including saving offers,
                                        viewing your order history, and receiving notifications. It's quick and easy to
                                        create an account on the website.</p>
                                </div>
                            </div>


                            <!-- Add more accordion items as needed -->
                        </div>




                    </div>




                    <div data-aos="fade-up" data-aos-duration="3000" class="col-md-5 mx-auto">




                        <div style="color: #8cc342" class="head">
                            Contact <span style="color: white;">Us</span>
                        </div>


                        <div class="row mt-3">
                            <div style="text-align: center;" class="col-md-6">
                                <img src="/images/phone.png" alt="">
                                <p>01220250041</p>
                            </div>

                       
                            <div style="text-align: center;" class="col-md-6">
                                <img src="/images/email.png" alt="">
                                <p>grabthegoodies360@gmai.com</p>
                            </div>

                           
                        </div>


                        <div class="row mt-5 ">
                            <div style="text-align: center;" class="col-md-6">
                                <a href="https://forms.gle/QmynT7uHgePpWbmY8" target="_blank"><img src="/images/form.png" alt=""></a>
                                
                               
                            </div>
                            <div  class="col-md-6">
                                <h5 style="color: #8cc342;">Business</h5>
                                <p>If you want to be a partner with us. <br><br>You can fill this form, and we will contact you in <span style="color: #8cc342;">3-5 days</span></p>
                            </div>

                       
                           

                           
                        </div>



                    </div>
                </div>
            </section>





        </div>

    </section>


     <!-- footer -->


     <div class="footer mt-5">
        <div class="horzintal-line mx-auto mt-5"></div>
        <div class="row mt-5 text-center">
            <!-- Navigation Links -->
            <div class="col-md-3 mx-auto">
                <ul id="nav">
                    <li class="nav-link">
                        <a href="/home">
                            <h1 data-name="Home">Home</h1>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-md-3 mx-auto">
                <ul id="nav">
                    <li class="nav-link">
                        <a href="/about">
                            <h1 data-name="About">About</h1>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-md-3 mx-auto">
                <ul id="nav">
                    <li class="nav-link">
                        <a href="/support">
                            <h1 data-name="Support">Support</h1>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    
        <!-- Dynamic Text and Social Links -->
        <div class="row mt-5 align-items-center">
            <!-- Typewriter Effect Text -->
            <div class="col-md-8 typewriter text-center">
                <p id="app"></p>
            </div>
            <!-- Social Media Icons -->
            <div class="col-md-4 text-center">
                <div class="row">
                    <div class="col-4">
                        <a href="https://www.facebook.com/GrabTheGoodies">
                            <img src="/images/facebook.png" alt="Facebook">
                        </a>
                    </div>
                    <div class="col-4">
                        <a href="https://www.linkedin.com/company/grab-the-goodies">
                            <img src="/images/linkedin.png" alt="LinkedIn">
                        </a>
                    </div>
                    <div class="col-4">
                        <a href="https://www.instagram.com/grab.the.goodies/">
                            <img src="/images/instagram.png" alt="Instagram">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- Copyright Section -->
        <div class="row copy-rights mt-5">
            <span class="w-100 text-center">Copyright © 2023—2024 Grap The Goodies. All Rights Reserved.</span>
        </div>
    </div>



    <script src="/aos/aos.js"></script>
    <script src="https://unpkg.com/typewriter-effect@latest/dist/core.js"></script>
    <script src="/bottstrap 5 modified/bootstrap.bundle.js"></script>
    <script src="/bottstrap 5 modified/bootstrap.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/index.js"></script>


    <script>
        AOS.init();
        var app = document.getElementById('app');

        var typewriter = new Typewriter(app, {
            loop: false,
            delay: 75,
        });

        typewriter
            .pauseFor(1000)

            .typeString('<span style="color: #8cc342;">Grab</span> The Goodies')
            .pauseFor(3000)
            .start();
    </script>
</body>

</html>