<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/aos/aos.css">
    <link rel="stylesheet" href="/bottstrap 5 modified/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/png" href="/images/logo_green.png">

    <title>GTG</title>
</head>

<body>
    <div class="row align-items-center text-center text-md-left">

        <!-- Logo -->
        <div class="nav-link col-12 col-md-6 mt-3">
            <img src="/images/logo_green.png" alt="Logo" class="img-fluid">
        </div>
        <!-- Shop Now Button -->
        
    
        
    
        <!-- Login/Signup Buttons -->
        <div class="col-12 col-md-6 mt-3 d-flex justify-content-center justify-content-md-end">
            <a href="/shop" class="me-2">
                <button class="reg">Shop Now</button>
            </a>
            <a  href="/partner/login" class="me-2 dissapear">
                <button class="log">Business</button>
            </a>
            <a href="/user/login" class="me-2 dissapear">
                <button class="reg">Log In</button>
            </a>
        </div>
    </div>

    <section>

        <div class="container">
            <section>
                <div class="row mt-5">
                    <video width="100%" src="/videos/video 01.mp4" autoplay muted></video>
                </div>

            </section>

            <div data-aos="fade-up" data-aos-duration="3000" class="seprate row align-items-center">
                <!-- Salad Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/carrot.png" alt="Salad Image" class="img-fluid">
                </div>
            
                <!-- Vertical Line -->
                <div class="col-12 col-md-4 d-flex justify-content-center">
                    <div class="vertical-line mt-4 mt-md-5"></div>
                </div>
            
                <!-- Bread Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/burger.png" alt="Bread Image" class="img-fluid">
                </div>
            </div>



            <section>
                <div data-aos="fade-up" data-aos-duration="3000" class="row mt-5">
                    <p class="p1">Together, we’re building a world where food is shared, not wasted <br> join <span
                            style="color: #8cc342;">Grap The Goodies</span> on this journey.</p>
                </div>
            </section>



            <div data-aos="fade-up" data-aos-duration="3000" class="seprate row align-items-center">
                <!-- Salad Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/meat.png" alt="Salad Image" class="img-fluid">
                </div>
            
                <!-- Vertical Line -->
                <div class="col-12 col-md-4 d-flex justify-content-center">
                    <div class="vertical-line mt-4 mt-md-5"></div>
                </div>
            
                <!-- Bread Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/sandwich.png" alt="Bread Image" class="img-fluid">
                </div>
            </div>


            <section>

                <div data-aos="fade-up" data-aos-duration="3000" class="row mt-5">
                    <p class="head">Why Use <br> <span style="color: #8cc342;">Grap The Goodies</span> </p>
                </div>

                <div data-aos="fade-up" data-aos-duration="3000" class="row">

                    <div class="col-md-4">
                        <p style="text-align: start;" class="p1"><span style="color: #8cc342;">Enjoy</span> food for 50%
                            off
                            or less and join to reduce food waste</p>
                        <img class="dissapear" src="/images/arrows-1.png" alt="">
                        <p style="text-align: start;" class="p1"><span style="color: #8cc342;">Help</span> the
                            environment
                            by reducing food waste</p>

                    </div>
                    <div class="dissapear col-md-4">
                        <img width="100%" style="margin-top: 50%; border-radius:50%"
                            src="/images/logo_green.png" alt="">
                    </div>

                    <div class="col-md-4">
                        <p style="text-align: end;" class="p1"><span style="color: #8cc342;">Try</span> something new
                            from
                            local cafes, bakeries or restaurants </p>
                        <img class="dissapear"  style="margin-right: 10px;" src="/images/arrows-2.png" alt="">
                        <p style="text-align: end;" class="p1"><span style="color: #8cc342;">Discover</span> surplus
                            food
                            nearby and rescue it from waste </p>

                    </div>
                </div>


            </section>

            <div data-aos="fade-up" data-aos-duration="3000" class="seprate row align-items-center">
                <!-- Salad Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/salad.png" alt="Salad Image" class="img-fluid">
                </div>
            
                <!-- Vertical Line -->
                <div class="col-12 col-md-4 d-flex justify-content-center">
                    <div class="vertical-line mt-4 mt-md-5"></div>
                </div>
            
                <!-- Bread Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/bread.png" alt="Bread Image" class="img-fluid">
                </div>
            </div>

            <section>
                <div data-aos="fade-up" data-aos-duration="3000" class="row mt-5">
                    <p class="head">How To Use <br> <span style="color: #8cc342;">Grap The Goodies</span> </p>
                </div>


                <div data-aos="fade-up" data-aos-duration="3000" class="row mt-5">
                    <div class="col-md-6">
                        <img src="/images/one.png" alt="">
                        <p style="text-align: start;" class="p1">Discover Surprise Bags available at stores and
                            restaurants near you.</p>

                    </div>
                    <div class="col-md-6">

                        <img src="/images/two.png" alt="">
                        <p class="p1" style="text-align: start;">Confirm your choice, reserve your food, and pay through
                            website.

                        </p>
                    </div>
                </div>


                <div data-aos="fade-up" data-aos-duration="3000" class="row mt-5">
                    <div class="col-md-6">
                        <img src="/images/three.png" alt="">
                        <p style="text-align: start;" class="p1">Head to the shop at the specified pickup time,<br> give
                            the
                            code, and enjoy your food.

                        </p>

                    </div>
                    <div class="col-md-6">

                        <img src="/images/four.png" alt="">
                        <p class="p1" style="text-align: start;">You've rescued food from going to waste and done
                            something good for the planet!

                        </p>
                    </div>
                </div>


            </section>
            <div data-aos="fade-up" data-aos-duration="3000" class="seprate row align-items-center">
                <!-- Salad Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/coffee.png" alt="Salad Image" class="img-fluid">
                </div>
            
                <!-- Vertical Line -->
                <div class="col-12 col-md-4 d-flex justify-content-center">
                    <div class="vertical-line mt-4 mt-md-5"></div>
                </div>
            
                <!-- Bread Image -->
                <div class="col-12 col-md-4 text-center mt-4 mt-md-5">
                    <img src="/images/doughnut.png" alt="Bread Image" class="img-fluid">
                </div>
            </div>

            <section>

                <div data-aos="fade-up" data-aos-duration="3000" class="row mt-5">
                    <p class="head">Our <span style="color: #8cc342;">Partners</span></p>
                </div>

                <div data-aos="fade-up" data-aos-duration="3000" class="row partners mt-5">
                    <div class="col-6  col-md-2 mb-3"><img src="/images/glal coffee.jpg" alt=""></div>
                    <div class="col-6  col-md-2 mb-3"><img src="/images/seoudi supermarket.jpg" alt=""></div>
                    <div class="col-6  col-md-2 mb-3"><img src="/images/hamad bakery.jpg" alt=""></div>
                    <div class="col-6  col-md-2 mb-3"><img src="/images/burger republic.jpg" alt=""></div>
                    <div class="col-6  col-md-2 mb-3"><img src="/images/hamad bakery.jpg" alt=""></div>
                    <div class="col-6  col-md-2 mb-3"><img src="/images/burger republic.jpg" alt=""></div>
                </div>

                <div data-aos="fade-up" data-aos-duration="3000" class="row partners mt-5">
                    <div class="col-6 col-md-2 mb-3"><img src="/images/glal coffee.jpg" alt=""></div>
                    <div class="col-6 col-md-2 mb-3"><img src="/images/seoudi supermarket.jpg" alt=""></div>
                    <div class="col-6 col-md-2 mb-3"><img src="/images/hamad bakery.jpg" alt=""></div>
                    <div class="col-6 col-md-2 mb-3"><img src="/images/burger republic.jpg" alt=""></div>
                    <div class="col-6 col-md-2 mb-3"><img src="/images/hamad bakery.jpg" alt=""></div>
                    <div class="col-6 col-md-2 mb-3"><img src="/images/burger republic.jpg" alt=""></div>
                </div>



            </section>



        </div>



    </section>


    <!-- footer -->


    <div class="footer mt-5">
        <div class="horzintal-line mx-auto mt-5"></div>
        <div class="row mt-5 text-center">
            <!-- Navigation Links -->
            <div class="col-md-3 mx-auto">
                <ul id="nav">
                    <li class="nav-link">
                        <a href="/home">
                            <h1 data-name="Home">Home</h1>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-md-3 mx-auto">
                <ul id="nav">
                    <li class="nav-link">
                        <a href="/about">
                            <h1 data-name="About">About</h1>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-md-3 mx-auto">
                <ul id="nav">
                    <li class="nav-link">
                        <a href="/support">
                            <h1 data-name="Support">Support</h1>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    
        <!-- Dynamic Text and Social Links -->
        <div class="row mt-5 align-items-center">
            <!-- Typewriter Effect Text -->
            <div class="col-md-8 typewriter text-center">
                <p id="app"></p>
            </div>
            <!-- Social Media Icons -->
            <div class="col-md-4 text-center">
                <div class="row">
                    <div class="col-4">
                        <a href="https://www.facebook.com/GrabTheGoodies">
                            <img src="/images/facebook.png" alt="Facebook">
                        </a>
                    </div>
                    <div class="col-4">
                        <a href="https://www.linkedin.com/company/grab-the-goodies">
                            <img src="/images/linkedin.png" alt="LinkedIn">
                        </a>
                    </div>
                    <div class="col-4">
                        <a href="https://www.instagram.com/grab.the.goodies/">
                            <img src="/images/instagram.png" alt="Instagram">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- Copyright Section -->
        <div class="row copy-rights mt-5">
            <span class="w-100 text-center">Copyright © 2023—2024 Grap The Goodies. All Rights Reserved.</span>
        </div>
    </div>


    <script src="/aos/aos.js"></script>
    <script src="https://unpkg.com/typewriter-effect@latest/dist/core.js"></script>
    <script src="/index.js"></script>


    <script>
        AOS.init();
        var app = document.getElementById('app');

        var typewriter = new Typewriter(app, {
            loop: false,
            delay: 75,
        });

        typewriter
            .pauseFor(1000)

            .typeString('<span style="color: #8cc342;">Grab</span> The Goodies')
            .pauseFor(3000)
            .start();
    </script>


</body>

</html>