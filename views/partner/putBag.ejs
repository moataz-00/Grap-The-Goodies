<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/bottstrap 5 modified/bootstrap.min.css">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="icon" type="image/png" href="/images/logo_green.png">
    <title>Create Bags</title>
</head>

<body>




    <%- include('partials/navbar') %>



        <div class="form-container">
            <div class=" row">
                <div style="text-align: center;" class="col-md-6 ">

                    <img src="/images/bread.png" alt="">
                </div>


                <div style="text-align: center;" class="col-md-6 ">
                    <img src="/images/carrot.png" alt="">
                </div>
            </div>
            <div class="row">

                <h1>Update <span style="color: #45a049;">
                        <%= bag.name %>
                    </span></h1>

            </div>

            <div class="row">

                <p style="color: #333; text-align:center">You cant update <span style="color: #45a049;">
                        bag
                    </span>quantity, less than reserved</p>

            </div>

            <form action="/partner/updateBag/<%= bag.id %>" method="POST" enctype="multipart/form-data" >
                <label for="name">Bag Name:</label>
                <input type="text" id="name" name="name" value=<%=bag.name %> required>


                <div style="text-align: center;">
                    
                    <img id="photoPreview" src="<%= bag.photo ? '/uploads/' + bag.photo : '/images/upload.png' %>" alt="Photo Preview"
                        style=" width: auto;height: 100px;border-radius:1%;margin-top: 15px;">
                </div>

                <div>
                    <label style="color:white" for="photo" class="custom-file-upload mt-3">Upload Bag Photo</label>
                    <input type="file" id="photo" name="photo" hidden accept="image/*" onchange="previewPhoto(this)">
                </div>

                <label for="description">Description:</label>
                <textarea id="description" name="description" rows="4" required><%= bag.description %></textarea>

                <label for="quantity">Quantity:</label>
                <input type="number" id="quantity" name="quantity" min="1" value=<%=bag.quantity %> required>

                <p style="color: #333;" class="mt-3"><span style="color: #45a049;">Pick Up Time Start:</span>
                    <%= new Date(bag.pickUpTimeStart).toLocaleString() %>
                </p>
                <label for="pickUpTime">Start Pick-Up Time:</label>
                <input type="datetime-local" id="pickUpTime" name="pickUpTimeStart" required >

                <p style="color: #333;" class="mt-3"><span style="color: #45a049;">Pick Up Time End:</span>
                    <%= new Date(bag.pickUpTimeEnd).toLocaleString() %>
                </p>
                <label for="pickUpTime">End Pick-Up Time:</label>
                <input type="datetime-local" id="pickUpTime" name="pickUpTimeEnd" required>




                <label for="priceBefore">Price Before Discount:</label>
                <input type="number" id="priceBefore" name="priceBefore" min="0" step="0.01" value=<%=bag.priceBefore %>
                required>

                <label for="priceAfter">Price After Discount:</label>
                <input type="number" id="priceAfter" name="priceAfter" min="0" step="0.01" value=<%=bag.priceAfter %>
                required>



                <button type="submit">Update Bag</button>
            </form>
        </div>




        <script src="/dashboard.js"></script>
</body>

</html>