<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/bottstrap 5 modified/bootstrap.min.css">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="icon" type="image/png" href="/images/logo_green.png">
    <title>Create Bags</title>
</head>

<body>




    <%- include('partials/navbar') %>



    <div class="form-container">

        <div class="row">
            
                  <h1>Hello <span style="color: #45a049;"><%= profile.name %></span> , lets save the world now</h1>
        
          </div>
        
        <form action="/partner/dashboard" method="POST" enctype="multipart/form-data">
            <label for="name">Bag Name:</label>
            <input type="text" id="name" name="name" required>

            <div style="text-align: center;">
                <img id="photoPreview"
                    src="/images/upload.png"
                    alt="Photo Preview"
                    style=" width: auto;height: 100px;border-radius:1%;margin-top: 15px;">
            </div>

            <div>
                <label style="color:white" for="photo" class="custom-file-upload mt-3">Upload Bag Photo</label>
                <input type="file" id="photo" name="photo" hidden accept="image/*"
                    onchange="previewPhoto(this)">
            </div>

            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="4" required></textarea>

            <label for="quantity">Quantity:</label>
            <input type="number" id="quantity" name="quantity" min="1" required>

            <label for="pickUpTime">Start Pick-Up Time:</label>
            <input type="datetime-local" id="pickUpTime" name="pickUpTimeStart" required>

            <label for="pickUpTime">End Pick-Up Time:</label>
            <input type="datetime-local" id="pickUpTime" name="pickUpTimeEnd" required>

            <label for="priceBefore">Price Before Discount:</label>
            <input type="number" id="priceBefore" name="priceBefore" min="0" step="0.01" required>

            <label for="priceAfter">Price After Discount:</label>
            <input type="number" id="priceAfter" name="priceAfter" min="0" step="0.01" required>

            <input type="hidden" name="partner_id" value="<%= profile.id %>"> <!-- Example partner ID -->

            <button type="submit">Create Bag</button>
        </form>
    </div>




    <script src="/dashboard.js"></script>
</body>

</html>