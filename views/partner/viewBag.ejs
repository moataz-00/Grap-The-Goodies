<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/bottstrap 5 modified/bootstrap.min.css">
  <link rel="stylesheet" href="/dashboard.css">
  <link rel="icon" type="image/png" href="/images/logo_green.png">
  <title>Profile</title>
</head>

<body>


  <%- include('./partials/navbar', { partnerId }) %>



    <div class="profile-container">

      <!-- Success message -->
      <% if (successMessage) { %>
        <div class="alert success">
          <%= successMessage %>
        </div>
        <% } %>

          <!-- Profile Card -->

          <div class=" row">
            <div style="text-align: center;" class="col-md-3 ">

              <img src="/images/bread.png" alt="">
            </div>
            <div style="text-align: center;" class="col-md-6 ">
              <img id="photoPreview" src="<%= bag.photo ? '/uploads/' + bag.photo : '/images/upload.png' %>"
                alt="Photo Preview" style=" width: 100%;height: 300px;border-radius:1%;">
            </div>

            <div style="text-align: center;" class="col-md-3 ">
              <img src="/images/carrot.png" alt="">
            </div>
          </div>
          <div class="profile-card">

            <div style="text-align: start;" class="profile-info mt-3">
              <h2 style="text-align: center;">
                <%= bag.name %>
              </h2>
              <p style="text-align: center;">
                <%= bag.description %>
              </p>
              <p class="mt-3"><span style="color: #45a049;">Pick Up Time Start:</span>

                <% const pickUpTimeStart=new Date(bag.pickUpTimeStart); %>
                  <%= pickUpTimeStart.getDate() %>/<%= pickUpTimeStart.getMonth() + 1 %>/<%= pickUpTimeStart.getFullYear() %>
              </p>
              <p class="mt-3"><span style="color: #45a049;">Pick Up Time End:</span>
                
                <% const pickUpTimeEnd=new Date(bag.pickUpTimeEnd); %>
                  <%= pickUpTimeEnd.getDate() %>/<%= pickUpTimeEnd.getMonth() + 1 %>/<%= pickUpTimeEnd.getFullYear() %>
              </p>
              <p class="mt-3"><span style="color: #45a049;">Quantity:</span>
                <%= bag.quantity %>
              </p>
              <p class="mt-3"><span style="color: #45a049;">Price After:</span>
                <%= bag.priceAfter %>
              </p>
              <p class="mt-3"><span style="color: #45a049;">Price Before:</span>
                <%= bag.priceBefore %>
              </p>

            </div>
            <div class="profile-actions">
              <div style="text-align: start;" class="row mt-3">



                <div class="col-md-2">
                  <a href="/partner/bagUpdate/<%= bag.bagId %>"><button class="edit-btn">Edit Bag</button></a>
                </div>


                <div class="col-md-2">
                  <% if (bag.reservedCount===0) { %>
                    <form method="POST" action="/admin/bags/<%= bag.bagId %>/delete">
                      <button class="delete-btn" type="submit">Delete</button>
                    </form>
                    <% } else { %>
                      <span style="color: red;">Cannot Delete (Reserved)</span>
                      <% } %>
                </div>




              </div>

            </div>
          </div>
    </div>

    <script>
      console(partnerId);
    </script>


    <script src="/dashboard.js"></script>
</body>

</html>